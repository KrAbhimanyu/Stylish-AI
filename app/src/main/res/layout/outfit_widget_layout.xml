<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="14dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="👗 TODAY'S AI OUTFIT"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#6200EE"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/widget_text_vibe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AURA STYLIST"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#3700B3"
            android:background="#EDE7F6"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:background="#E0E0E0" />

    <!-- Outfit Title & Occasion -->
    <TextView
        android:id="@+id/widget_text_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Maroon Silk Kurta &amp; Mojris"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:ellipsize="end"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_text_occasion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Occasion: Marriage Sangeet • Royal Aesthetic"
        android:textSize="11sp"
        android:textColor="#616161"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1" />

    <!-- Garments List Preview -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/widget_text_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👕 Top: Deep Maroon Silk Kurta"
            android:textSize="12sp"
            android:textColor="#424242"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_text_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="👖 Bottom: Cream Churidar Pajama"
            android:textSize="12sp"
            android:textColor="#424242"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_text_footwear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="👟 Shoes: Handcrafted Gold Mojris"
            android:textSize="12sp"
            android:textColor="#424242"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:background="#E0E0E0" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/widget_btn_gallery"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Saved Gallery 🖼️"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6200EE" />

        <Button
            android:id="@+id/widget_btn_stylist"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Style New ✦"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#03DAC5" />
    </LinearLayout>

</LinearLayout>
